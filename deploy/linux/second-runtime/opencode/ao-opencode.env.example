# Load these settings into the AO daemon environment for its OpenCode profile.
# Point the URL at the existing CLIProxyAPI ChatCompletions route; do not add a
# second proxy deployment or configure a Responses API fallback.
AO_OPENCODE_EXTERNAL_BASE_URL=
AO_OPENCODE_EXTERNAL_API_KEY_FILE=
AO_OPENCODE_EXTERNAL_MODEL=
AO_OPENCODE_CONTAINER_IMAGE=cylo-ao-opencode:1.18.33
AO_OPENCODE_DOCKER_BINARY=/usr/bin/docker
