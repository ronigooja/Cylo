# Zoe-owned OpenCode runtime settings. Use immutable image references in production.
ZOE_OPENCODE_IMAGE=ghcr.io/ronigooja/zoe-opencode@sha256:OPENCODE_IMAGE_DIGEST
ZOE_OPENCODE_PROVIDER_BASE_URL=http://127.0.0.1:8788/v1
ZOE_OPENCODE_PROVIDER_KEY_FILE=/etc/zoe/runner-secrets/cliproxyapi-api-key
ZOE_OPENCODE_MODEL=provider/model
ZOE_OPENCODE_PROVIDER_SOCKET=/run/zoe/provider.sock
