<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld tasks</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@tasks@</string>
		<key>tasks</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>%lld tasks</string>
			<key>one</key>
			<string>%lld task</string>
		</dict>
	</dict>
	<key>Recovered %lld command receipt(s) from this device's durable queue.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%#@receipts@</string>
		<key>receipts</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>other</key>
			<string>Recovered %lld command receipts from this device's durable queue.</string>
			<key>one</key>
			<string>Recovered %lld command receipt from this device's durable queue.</string>
		</dict>
	</dict>
</dict>
</plist>
