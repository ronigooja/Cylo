# Load these settings into the AO daemon environment. The daemon uses the
# canonical external provider variables below for every runtime profile,
# including this OpenCode example; do not create AO_OPENCODE_EXTERNAL_* aliases.
# Point the URL at the existing CLIProxyAPI route. The token is read from the
# private file and must never be placed directly in this environment file.
AO_CODEX_EXTERNAL_BASE_URL=
AO_CODEX_EXTERNAL_API_KEY_FILE=/etc/cylo/runner-secrets/cliproxyapi-api-key
AO_CODEX_EXTERNAL_MODEL=
AO_CODEX_CONTAINER_IMAGE=cylo-ao-opencode:1.18.33
AO_CODEX_DOCKER_BINARY=/usr/bin/docker
