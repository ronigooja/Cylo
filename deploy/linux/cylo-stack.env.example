# Copy to /etc/cylo/cylo-stack.env and set deployment-specific values.
# Secret variables below are file references, never secret contents.
CYLO_SERVER_IMAGE=cylo-server:release-id
CYLO_MEMORY_WORKER_IMAGE=cylo-memory-worker:release-id
CYLO_SERVER_PORT=8787
CYLO_SERVER_DATA_ROOT=/var/lib/cylo/server
CYLO_MEMORY_DATA_ROOT=/var/lib/cylo/memory
CYLO_BOOTSTRAP_CODE_FILE=/etc/cylo/secrets/bootstrap-code
CYLO_RUNNER_TOKEN_FILE=/etc/cylo/secrets/runner-token
CYLO_MEMORY_RUNNER_TOKEN_FILE=/etc/cylo/secrets/memory-runner-token
CYLO_MEM0_LLM_API_KEY_FILE=/etc/cylo/secrets/mem0-llm-api-key
CYLO_RUNTIME_PROFILES={}
CYLO_DEFAULT_PROFILE_ID=worker
CYLO_MEM0_LLM_MODEL=deployment-selected-model
CYLO_MEM0_LLM_BASE_URL=https://deployment-provided-existing-gateway.example.invalid/v1

# Configure only when a voice gateway account is separately provisioned.
# CYLO_VOICE_GATEWAY_URL=
