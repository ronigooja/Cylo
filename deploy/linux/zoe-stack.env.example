# Copy to /etc/zoe/zoe-stack.env and set deployment-specific values.
# Secret variables below are file references, never secret contents.
ZOE_SERVER_IMAGE=zoe-server:release-id
ZOE_MEMORY_WORKER_IMAGE=zoe-memory-worker:release-id
ZOE_SERVER_PORT=8787
ZOE_SERVER_DATA_ROOT=/var/lib/zoe/server
ZOE_MEMORY_DATA_ROOT=/var/lib/zoe/memory
ZOE_INSTANCE_KEY_FILE=/etc/zoe/secrets/instance-key
ZOE_RUNNER_TOKEN_FILE=/etc/zoe/secrets/runner-token
ZOE_MEMORY_RUNNER_TOKEN_FILE=/etc/zoe/secrets/memory-runner-token
ZOE_MEM0_LLM_API_KEY_FILE=/etc/zoe/secrets/mem0-llm-api-key
ZOE_RUNTIME_PROFILES={}
ZOE_DEFAULT_PROFILE_ID=worker
ZOE_MEM0_LLM_MODEL=deployment-selected-model
ZOE_MEM0_LLM_BASE_URL=https://deployment-provided-existing-gateway.example.invalid/v1

# Capability service execution is disabled by default. To enable the Docker
# executor, configure a deployment-owned capability registry and explicitly
# grant the runner capability:deploy in ZOE_RUNNER_SCOPES. Never add that
# scope to an existing runner credential without a deliberate credential
# rotation/re-registration procedure.
# ZOE_CAPABILITY_RUNTIME_BACKEND=docker
# ZOE_AVAILABLE_CAPABILITY_IDS=mail.read,calendar.read
# ZOE_RUNNER_SCOPES=runner:claim,runner:observe,runner:control:read,capability:deploy

# Configure only when a voice gateway account is separately provisioned.
# ZOE_VOICE_GATEWAY_URL=
# Enable only after the Space gateway implements account lease identity and
# exact idempotent account-scoped release evidence. Defaults to disabled.
# ZOE_VOICE_ACCOUNT_MEDIA_ENABLED=false
