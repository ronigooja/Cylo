+package codexappserver
+
+import (
+	"context"
+	"crypto/sha256"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"sync"
+	"time"
+
+	"github.com/aoagents/agent-orchestrator/backend/internal/ports"
+	aoprocess "github.com/aoagents/agent-orchestrator/backend/internal/process"
+)
+
+const (
+	containerModeEnv    = "CYLO_CODEX_CONTAINER"
+	containerImageEnv   = "AO_CODEX_CONTAINER_IMAGE"
+	providerUpstreamEnv = "CYLO_CODEX_PROXY_UPSTREAM"
+	providerKeyEnv      = "CYLO_CODEX_PROXY_KEY"
+	providerModelEnv    = "CYLO_CODEX_PROXY_MODEL"
+	sessionIDEnv        = "CYLO_CODEX_SESSION_ID"
+)
+
+func spawnContainerAppServer(ctx context.Context, workdir string, env []string) (*process, error) {
+	values := environmentMap(env)
+	sessionID := strings.TrimSpace(values[sessionIDEnv])
+	image := strings.TrimSpace(values[containerImageEnv])
+	home := strings.TrimSpace(values["CODEX_HOME"])
+	providerKey := strings.TrimSpace(values[providerKeyEnv])
+	providerModel := strings.TrimSpace(values[providerModelEnv])
+	if providerKey == "" {
+		providerKey = strings.TrimSpace(values["CYLO_CODEX_API_KEY"])
+	}
+	if sessionID == "" || image == "" || home == "" || providerModel == "" || !filepath.IsAbs(workdir) || !filepath.IsAbs(home) {
+		return nil, errors.New("supervised Codex container requires session identity, image, absolute workspace, and private CODEX_HOME")
+	}
+	if strings.ContainsAny(sessionID+image+workdir+home, "\x00\r\n,") || strings.HasPrefix(image, "-") {
+		return nil, errors.New("supervised Codex container configuration is invalid")
+	}
+	if info, err := os.Stat(workdir); err != nil || !info.IsDir() {
+		return nil, errors.New("supervised Codex workspace is unavailable")
+	}
+	if info, err := os.Stat(home); err != nil || !info.IsDir() {
+		return nil, errors.New("supervised Codex home is unavailable")
+	}
+	broker, err := startProviderBroker(values[providerUpstreamEnv], providerKey, providerModel)
+	if err != nil {
+		return nil, err
+	}
+	root := filepath.Dir(broker.SocketPath())
+	cidfile := filepath.Join(root, "container-id")
+	docker := strings.TrimSpace(values["AO_CODEX_DOCKER_BINARY"])
+	if docker == "" {
+		docker = "docker"
+	}
+	// The caller context owns startup only; session lifetime is owned by the
+	// returned process's terminate closure. AO cancels its HTTP create context
+	// after sending the session response, so tying the attach process directly to
+	// that request would orphan the container and close the controller pipes.
+	processCtx, cancelProcess := context.WithCancel(context.Background())
+	name := "cylo-ao-" + shortSessionHash(sessionID)
+	uidgid := fmt.Sprintf("%d:%d", os.Getuid(), os.Getgid())
+	args := []string{
+		"run", "--rm", "--init", "-i", "--cidfile", cidfile,
+		"--name", name,
+		"--label", "io.cylo.managed=true",
+		"--label", "io.cylo.runtime=ao-codex-chat",
+		"--label", "io.cylo.ao.session=" + sessionID,
+		"--network", "none", "--cap-drop", "ALL", "--security-opt", "no-new-privileges",
+		"--read-only", "--pids-limit", "256", "--memory", "2g", "--cpus", "2",
+		"--user", uidgid,
+		"--tmpfs", "/tmp:rw,nosuid,nodev,noexec,size=256m",
+		// Bind mounts are read/write by default; Docker's --mount parser does
+		// not accept the bare `rw` option supported by --volume.
+		"--mount", "type=bind,src=" + workdir + ",dst=" + workdir,
+		"--mount", "type=bind,src=" + home + ",dst=/codex-home",
+		"--mount", "type=bind,src=" + broker.SocketPath() + ",dst=/run/cylo/provider.sock,readonly",
+		"--workdir", workdir,
+		"--env", "CODEX_HOME=/codex-home",
+		"--env", "HOME=/tmp",
+		"--env", "CYLO_PROVIDER_SOCKET=/run/cylo/provider.sock",
+		// Codex expects the configured env_key to exist even though auth is
+		// disabled. The host broker always replaces Authorization upstream.
+		"--env", "CYLO_CONTAINER_PROXY_NO_AUTH=cylo-provider-broker-no-auth",
+		"--env", "PATH=/usr/local/bin:/usr/bin:/bin",
+		image,
+		"--", "/usr/local/bin/codex",
+		"-c", `model_provider="cylo_external"`,
+		"-c", `model_providers.cylo_external.base_url="http://127.0.0.1:47631/v1"`,
+		"-c", `model_providers.cylo_external.env_key="CYLO_CONTAINER_PROXY_NO_AUTH"`,
+		"-c", `model_providers.cylo_external.requires_openai_auth=false`,
+		"-c", `sandbox_mode="danger-full-access"`,
+		"app-server",
+	}
+	// The Docker attach process must outlive the HTTP request that starts a
+	// session. Startup cancellation is handled explicitly below; tying the child
+	// to that short-lived context would close the controller pipes immediately
+	// after AO returns the newly created session.
+	cmd := aoprocess.CommandContext(processCtx, docker, args...)
+	cmd.Dir = workdir
+	// Docker receives no provider key or AO session environment. The credential
+	// is held only by the in-process host broker above.
+	cmd.Env = sanitizedDockerEnvironment(env)
+	stdin, err := cmd.StdinPipe()
+	if err != nil {
+		cancelProcess()
+		_ = broker.Close()
+		return nil, fmt.Errorf("container stdin pipe: %w", err)
+	}
+	stdout, err := cmd.StdoutPipe()
+	if err != nil {
+		cancelProcess()
+		_ = broker.Close()
+		return nil, fmt.Errorf("container stdout pipe: %w", err)
+	}
+	stderr, err := cmd.StderrPipe()
+	if err != nil {
+		cancelProcess()
+		_ = broker.Close()
+		return nil, fmt.Errorf("container stderr pipe: %w", err)
+	}
+	if err := cmd.Start(); err != nil {
+		cancelProcess()
+		_ = broker.Close()
+		return nil, fmt.Errorf("start supervised Codex container: %w", err)
+	}
+	go func() { _, _ = io.Copy(io.Discard, stderr) }()
+	done := make(chan error, 1)
+	go func() {
+		done <- cmd.Wait()
+		close(done)
+	}()
+	containerID, err := waitContainerID(ctx, done, cidfile)
+	if err != nil {
+		_ = stdin.Close()
+		_ = cmd.Process.Kill()
+		<-done
+		cleanupErr := cleanupStartingContainer(docker, cidfile, sessionID, done)
+		cancelProcess()
+		if cleanupErr == nil {
+			_ = broker.Close()
+			return nil, err
+		}
+		// A failed creation has no process handle for AO to retry through. Close
+		// the credential-bearing broker even if exact container cleanup cannot be
+		// verified; the session labels remain available to supervisor recovery.
+		_ = broker.Close()
+		return nil, fmt.Errorf("%w; supervised Codex startup cleanup could not be verified: %v", err, cleanupErr)
+	}
+	var stopMu sync.Mutex
+	stopped := false
+	var verifiedAt time.Time
+	stop := func() error {
+		stopMu.Lock()
+		defer stopMu.Unlock()
+		if stopped {
+			return nil
+		}
+		_ = stdin.Close()
+		stopErr := stopContainerAndWait(docker, containerID, done)
+		if stopErr != nil {
+			// The callback remains available for a later retry. The command wait
+			// goroutine always reaps Docker, even if Docker exits independently.
+			return stopErr
+		}
+		cancelProcess()
+		if brokerErr := broker.Close(); brokerErr != nil {
+			return brokerErr
+		}
+		stopped = true
+		verifiedAt = time.Now().UTC()
+		return nil
+	}
+	terminateWithProof := func() (ports.ChatTerminationProof, error) {
+		if err := stop(); err != nil {
+			return ports.ChatTerminationProof{}, err
+		}
+		stopMu.Lock()
+		defer stopMu.Unlock()
+		if !stopped || verifiedAt.IsZero() || sessionID == "" {
+			return ports.ChatTerminationProof{}, errors.New("supervised Codex process exit is unverified")
+		}
+		return ports.ChatTerminationProof{SessionID: sessionID, Method: ports.ChatTerminationNativeProcessExitWaited, CleanupComplete: true, VerifiedAt: verifiedAt}, nil
+	}
+	return &process{
+		stdin: stdin, stdout: stdout,
+		stop:               stop,
+		terminate:          stop,
+		terminateWithProof: terminateWithProof,
+	}, nil
+}
+
+func cleanupStartingContainer(docker, cidfile, sessionID string, done <-chan error) error {
+	containerID := ""
+	if data, err := os.ReadFile(cidfile); err == nil {
+		candidate := strings.TrimSpace(string(data))
+		if validContainerID(candidate) {
+			containerID = candidate
+		}
+	}
+	if containerID == "" {
+		ctx, cancel := context.WithTimeout(context.Background(), 5*time.Second)
+		defer cancel()
+		args := []string{"ps", "-aq", "--no-trunc",
+			"--filter", "label=io.cylo.managed=true",
+			"--filter", "label=io.cylo.runtime=ao-codex-chat",
+			"--filter", "label=io.cylo.ao.session=" + sessionID,
+		}
+		output, err := exec.CommandContext(ctx, docker, args...).CombinedOutput()
+		if err != nil {
+			return errors.New("could not inspect containers created for this session")
+		}
+		ids := strings.Fields(string(output))
+		if len(ids) == 0 {
+			return nil
+		}
+		if len(ids) != 1 || !validContainerID(ids[0]) {
+			return errors.New("session labels matched an ambiguous container set")
+		}
+		containerID = ids[0]
+	}
+	return stopContainerAndWait(docker, containerID, done)
+}
+
+func validContainerID(id string) bool {
+	return len(id) >= 12 && len(id) <= 128 && isHex(id)
+}
+
+func supervisedExternalRoute(env map[string]string, image string) (bool, error) {
+	if strings.TrimSpace(env["CYLO_CODEX_PROFILE_ERROR"]) != "" {
+		return false, errors.New("external Codex worker profile is incomplete")
+	}
+	if strings.TrimSpace(env[providerUpstreamEnv]) == "" {
+		return false, nil
+	}
+	if strings.TrimSpace(image) == "" {
+		return false, errors.New("external Codex worker route requires the supervised container image")
+	}
+	return true, nil
+}
+
+func waitContainerID(ctx context.Context, done <-chan error, path string) (string, error) {
+	deadline := time.NewTimer(10 * time.Second)
+	defer deadline.Stop()
+	ticker := time.NewTicker(20 * time.Millisecond)
+	defer ticker.Stop()
+	for {
+		if data, err := os.ReadFile(path); err == nil {
+			id := strings.TrimSpace(string(data))
+			if validContainerID(id) {
+				// Docker writes the complete ID before the container command starts.
+				// cmd.Wait remains owned by the process stop closure below.
+				return id, nil
+			}
+		}
+		select {
+		case err := <-done:
+			return "", fmt.Errorf("Codex container exited before reporting its identity: %w", err)
+		case <-ctx.Done():
+			return "", ctx.Err()
+		case <-deadline.C:
+			return "", errors.New("Codex container did not report an identity before startup timeout")
+		case <-ticker.C:
+		}
+	}
+}
+
+func stopContainerAndWait(docker, containerID string, done <-chan error) error {
+	ctx, cancel := context.WithTimeout(context.Background(), 12*time.Second)
+	defer cancel()
+	_, stopErr := exec.CommandContext(ctx, docker, "stop", "--time", "5", containerID).CombinedOutput()
+	missing, inspectErr := inspectContainerMissing(ctx, docker, containerID)
+	if inspectErr != nil {
+		return inspectErr
+	}
+	if !missing {
+		// Force removal targets only the ID read from this launch's cidfile.
+		if _, err := exec.CommandContext(ctx, docker, "rm", "--force", containerID).CombinedOutput(); err != nil {
+			if stopErr != nil {
+				return errors.New("supervised Codex container could not be terminated")
+			}
+		}
+		missing, inspectErr = inspectContainerMissing(ctx, docker, containerID)
+		if inspectErr != nil {
+			return inspectErr
+		}
+		if !missing {
+			return errors.New("supervised Codex container still exists after stop")
+		}
+	}
+	select {
+	case <-done:
+	case <-ctx.Done():
+		return errors.New("Docker attach process did not exit after container termination")
+	}
+	return nil
+}
+
+func inspectContainerMissing(ctx context.Context, docker, id string) (bool, error) {
+	output, err := exec.CommandContext(ctx, docker, "inspect", id).CombinedOutput()
+	if err == nil {
+		return false, nil
+	}
+	message := strings.ToLower(string(output))
+	if strings.Contains(message, "no such object") || strings.Contains(message, "no such container") {
+		return true, nil
+	}
+	return false, errors.New("supervised Codex container termination could not be verified")
+}
+
+func environmentMap(env []string) map[string]string {
+	out := make(map[string]string, len(env))
+	for _, item := range env {
+		key, value, ok := strings.Cut(item, "=")
+		if ok {
+			out[key] = value
+		}
+	}
+	return out
+}
+
+func sanitizedDockerEnvironment(env []string) []string {
+	values := environmentMap(env)
+	for key := range values {
+		if strings.HasPrefix(key, "CYLO_CODEX_") || key == "CYLO_PROVIDER_SOCKET" {
+			delete(values, key)
+		}
+	}
+	out := make([]string, 0, len(values))
+	for key, value := range values {
+		out = append(out, key+"="+value)
+	}
+	return out
+}
+
+func shortSessionHash(sessionID string) string {
+	return fmt.Sprintf("%x", sha256.Sum256([]byte(sessionID)))[:16]
+}
+
+func isHex(value string) bool {
+	for _, r := range value {
+		if !((r >= '0' && r <= '9') || (r >= 'a' && r <= 'f') || (r >= 'A' && r <= 'F')) {
+			return false
+		}
+	}
+	return value != ""
+}
diff --git a/backend/internal/adapters/chatdriver/codexappserver/container_lifecycle_linux_test.go b/backend/internal/adapters/chatdriver/codexappserver/container_lifecycle_linux_test.go
new file mode 100644
index 000000000..48ae12af2
--- /dev/null
+++ b/backend/internal/adapters/chatdriver/codexappserver/container_lifecycle_linux_test.go
@@ -0,0 +1,212 @@
+//go:build linux
+
+package codexappserver
+
+import (
+	"context"
+	"fmt"
+	"os"
+	"path/filepath"
+	"strconv"
+	"strings"
+	"syscall"
+	"testing"
+	"time"
+
+	"github.com/aoagents/agent-orchestrator/backend/internal/ports"
+)
+
+func TestContainerAttachOutlivesRequestContextAndStopsWithSession(t *testing.T) {
+	docker, pidPath, stoppedPath := fakeDockerAttach(t, true)
+	ctx, cancel := context.WithCancel(context.Background())
+	proc, err := spawnContainerAppServer(ctx, t.TempDir(), containerTestEnv(docker))
+	if err != nil {
+		t.Fatalf("start fake supervised container: %v", err)
+	}
+	cancel()
+
+	if _, err := proc.stdin.Write([]byte("still-attached\n")); err != nil {
+		t.Fatalf("HTTP request cancellation closed the AO-owned Docker attach: %v", err)
+	}
+	if err := proc.stop(); err != nil {
+		t.Fatalf("stop exact supervised container and attach: %v", err)
+	}
+	if _, err := os.Stat(stoppedPath); err != nil {
+		t.Fatalf("exact container stop was not requested: %v", err)
+	}
+	assertProcessGone(t, pidPath)
+}
+
+func TestContainerStopProofBindsExactSessionAndOriginalWaitTime(t *testing.T) {
+	docker, _, _ := fakeDockerAttach(t, true)
+	proc, err := spawnContainerAppServer(context.Background(), t.TempDir(), containerTestEnv(docker))
+	if err != nil {
+		t.Fatalf("start fake supervised container: %v", err)
+	}
+	proof, err := proc.terminateWithProof()
+	if err != nil {
+		t.Fatalf("stop exact supervised container and wait for attach: %v", err)
+	}
+	if proof.SessionID != "container-lifecycle-test" || proof.Method != ports.ChatTerminationNativeProcessExitWaited || !proof.CleanupComplete || proof.VerifiedAt.IsZero() {
+		t.Fatalf("termination proof = %+v", proof)
+	}
+	replayed, err := proc.terminateWithProof()
+	if err != nil || replayed != proof {
+		t.Fatalf("replayed proof = %+v, err=%v; want exact original %+v", replayed, err, proof)
+	}
+}
+
+func TestContainerStartupCancellationKillsUnidentifiedAttach(t *testing.T) {
+	docker, pidPath, _ := fakeDockerAttach(t, false)
+	ctx, cancel := context.WithCancel(context.Background())
+	result := make(chan error, 1)
+	go func() {
+		_, err := spawnContainerAppServer(ctx, t.TempDir(), containerTestEnv(docker))
+		result <- err
+	}()
+	deadline := time.Now().Add(3 * time.Second)
+	for {
+		if _, err := os.Stat(pidPath); err == nil {
+			break
+		}
+		if time.Now().After(deadline) {
+			t.Fatal("fake Docker attach did not start")
+		}
+		time.Sleep(10 * time.Millisecond)
+	}
+	cancel()
+	select {
+	case err := <-result:
+		if err == nil {
+			t.Fatal("startup cancellation unexpectedly returned a live container")
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("startup cancellation did not return")
+	}
+	assertProcessGone(t, pidPath)
+}
+
+func TestContainerStopFailureRetainsRetryableHandle(t *testing.T) {
+	docker, pidPath, _ := fakeDockerAttach(t, true)
+	stopCount := filepath.Join(filepath.Dir(docker), "stop.count")
+	script := `#!/bin/sh
+case "$1" in
+  run)
+    cidfile=""
+    while [ "$#" -gt 0 ]; do
+      if [ "$1" = "--cidfile" ]; then shift; cidfile="$1"; fi
+      shift
+    done
+    echo "$$" > ` + shellQuote(pidPath) + `
+    printf '%064d\n' 1 > "$cidfile"
+    exec sleep 60
+    ;;
+  stop)
+    count=0
+    [ ! -f ` + shellQuote(stopCount) + ` ] || count=$(cat ` + shellQuote(stopCount) + `)
+    count=$((count + 1))
+    echo "$count" > ` + shellQuote(stopCount) + `
+    if [ "$count" -eq 1 ]; then exit 1; fi
+    kill -TERM "$(cat ` + shellQuote(pidPath) + `)" 2>/dev/null || true
+    exit 0
+    ;;
+  inspect)
+    count=0
+    [ ! -f ` + shellQuote(stopCount) + ` ] || count=$(cat ` + shellQuote(stopCount) + `)
+    if [ "$count" -lt 2 ]; then echo '{}'; exit 0; fi
+    echo 'No such container' >&2
+    exit 1
+    ;;
+  rm) exit 1 ;;
+  *) exit 2 ;;
+esac
+`
+	if err := os.WriteFile(docker, []byte(script), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	proc, err := spawnContainerAppServer(context.Background(), t.TempDir(), containerTestEnv(docker))
+	if err != nil {
+		t.Fatalf("start fake supervised container: %v", err)
+	}
+	if err := proc.stop(); err == nil {
+		t.Fatal("first stop unexpectedly succeeded without proving container removal")
+	}
+	if err := proc.stop(); err != nil {
+		t.Fatalf("retry stop after an unverified failure: %v", err)
+	}
+	assertProcessGone(t, pidPath)
+}
+
+func containerTestEnv(docker string) []string {
+	return []string{
+		"CYLO_CODEX_SESSION_ID=container-lifecycle-test",
+		"AO_CODEX_CONTAINER_IMAGE=cylo-ao-codex:test",
+		"AO_CODEX_DOCKER_BINARY=" + docker,
+		"CYLO_CODEX_PROXY_UPSTREAM=https://provider.invalid/v1",
+		"CYLO_CODEX_PROXY_KEY=fixture-only-provider-key",
+		"CYLO_CODEX_PROXY_MODEL=gpt-6-luna",
+		"CODEX_HOME=/tmp",
+	}
+}
+
+func fakeDockerAttach(t *testing.T, writeContainerID bool) (docker, pidPath, stoppedPath string) {
+	t.Helper()
+	root := t.TempDir()
+	docker = filepath.Join(root, "docker")
+	pidPath = filepath.Join(root, "attach.pid")
+	stoppedPath = filepath.Join(root, "container.stopped")
+	cidCommand := ""
+	if writeContainerID {
+		cidCommand = `printf '%064d\n' 1 > "$cidfile"`
+	}
+	script := fmt.Sprintf(`#!/bin/sh
+pidfile=%q
+stopped=%q
+case "$1" in
+  run)
+    cidfile=""
+    while [ "$#" -gt 0 ]; do
+      if [ "$1" = "--cidfile" ]; then shift; cidfile="$1"; fi
+      shift
+    done
+    echo "$$" > "$pidfile"
+    %s
+    exec sleep 60
+    ;;
+  stop)
+    echo stopped > "$stopped"
+    kill -TERM "$(cat "$pidfile")" 2>/dev/null || true
+    exit 0
+    ;;
+  inspect)
+    echo "No such container" >&2
+    exit 1
+    ;;
+  ps) exit 0 ;;
+  *) exit 2 ;;
+esac
+`, pidPath, stoppedPath, cidCommand)
+	if err := os.WriteFile(docker, []byte(script), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	return docker, pidPath, stoppedPath
+}
+
+func shellQuote(value string) string {
+	return "'" + strings.ReplaceAll(value, "'", "'\\''") + "'"
+}
+
+func assertProcessGone(t *testing.T, pidPath string) {
+	t.Helper()
+	contents, err := os.ReadFile(pidPath)
+	if err != nil {
+		return // The command may have been killed before it recorded its PID.
+	}
+	pid, err := strconv.Atoi(strings.TrimSpace(string(contents)))
+	if err != nil {
+		t.Fatalf("fake Docker attach PID is invalid: %v", err)
+	}
+	if err := syscall.Kill(pid, 0); err == nil || err != syscall.ESRCH {
+		t.Fatalf("Docker attach PID %d is still alive or cannot be verified gone: %v", pid, err)
+	}
+}
diff --git a/backend/internal/adapters/chatdriver/codexappserver/container_test.go b/backend/internal/adapters/chatdriver/codexappserver/container_test.go
new file mode 100644
