[Unit]
Description=Cylo server and memory Compose stack
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/cylo/releases/current
EnvironmentFile=/etc/cylo/cylo-stack.env
ExecStartPre=/usr/bin/docker compose --env-file /etc/cylo/cylo-stack.env -f deploy-linux/docker-compose.yml config --quiet
ExecStart=/usr/bin/docker compose --env-file /etc/cylo/cylo-stack.env -f deploy-linux/docker-compose.yml up --no-color --abort-on-container-exit
ExecStop=/usr/bin/docker compose --env-file /etc/cylo/cylo-stack.env -f deploy-linux/docker-compose.yml down --remove-orphans
Restart=on-failure
RestartSec=5s
TimeoutStartSec=0
TimeoutStopSec=60s
StartLimitIntervalSec=300s
StartLimitBurst=10

[Install]
WantedBy=multi-user.target
