# Copy to /etc/zoe/zoe-runner.env. Token values are read from private files
# by zoe-secret-entrypoint and are not stored in this environment file.
# Set this to the private, reachable control-plane URL for this runner host.
ZOE_CONTROL_URL=https://zoe-control.example.internal
ZOE_RUNNER_JOURNAL_PATH=/var/lib/zoe/runner/journal.sqlite
ZOE_RUNNER_ROUTES={"worker":{"profile_id":"worker","runtime_route_id":"opencode","model_route_id":"default","isolation_policy":"opencode-workspace-write-v1","harness":"opencode","model":"provider/model","approval_mode":"accept-edits"}}
# Published by the Zoe OpenCode runtime image workflow/release process.
# Replace the placeholder with the reviewed digest; deploy by digest, not a tag.
ZOE_OPENCODE_IMAGE=ghcr.io/ronigooja/zoe-opencode@sha256:OPENCODE_IMAGE_DIGEST
ZOE_OPENCODE_MODEL=provider/model
ZOE_OPENCODE_PROVIDER_SOCKET=/run/zoe/provider.sock
# Parent of per-run workspaces; the runner mounts only <root>/<run-id>, read-write.
ZOE_OPENCODE_WORKSPACE_ROOT=/var/lib/zoe/runner/workspaces
# Capability deployment claims use the same runner process. Enable the
# control-plane backend and grant capability:deploy to this runner's token
# only when the runner host is authorized to manage bounded Docker services.
# ZOE_DOCKER_BINARY=docker

# The runner owns the OpenCode container lifecycle. CLIProxyAPI remains an
# external provider and is not installed or reconfigured by this unit.
